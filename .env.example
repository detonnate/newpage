# Copy to .env for local Gemini generation. Never commit the real .env file.
# Google supports both names; GOOGLE_API_KEY takes precedence if both are set.
GOOGLE_API_KEY=
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-flash-latest
# Optional: override the default sample document directory.
# NEWPAGE_DOCS_DIR=sample_docs